#!/usr/bin/env bash
# maistro-doctor: checks dependencies and configuration. Exit code 1 if something required is missing.
. "$(dirname "$0")/lib.sh"

fail=0
ok()   { printf '  ok    %s\n' "$*"; }
warn() { printf '  warn  %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; fail=1; }

echo "maistro doctor: $REPO_ROOT"
[ -f "$MAISTRO_HOME/VERSION" ] && echo "maistro version: $(cat "$MAISTRO_HOME/VERSION")"
echo "required:"
git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 && ok "git repository" || bad "not a git repository"
load_harness
if harness_check; then ok "harness: $HARNESS_NAME"; else bad "harness: $HARNESS_NAME is not installed"; fi
for c in git tmux; do
  if command -v "$c" >/dev/null 2>&1; then ok "$c: $("$c" --version 2>/dev/null | head -n1 || "$c" -V 2>/dev/null)"
  else bad "$c not found"; fi
done

echo "for PRs and merges:"
if command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then ok "gh authenticated"; else warn "gh installed but not logged in (run: gh auth login)"; fi
else warn "gh not found (https://cli.github.com); you can still build locally, but not open or merge PRs"; fi
command -v jq >/dev/null 2>&1 && ok "jq" || warn "jq not found (needed by maistro-merge)"
has_origin && ok "origin: $(git -C "$REPO_ROOT" remote get-url origin)" || warn "no 'origin' remote (local-only mode: no PRs)"

echo "configuration:"
ok "base branch: $(base_branch)"
ok "max parallel workers: $MAISTRO_MAX_PARALLEL"
ok "worker permission mode: $MAISTRO_WORKER_PERMISSION_MODE"
ok "worklogs: $MAISTRO_WORKLOG_DIR/<task>.md"
ok "tmux session: $(session_name)"
[ -x "$MAISTRO_HOME/config/setup-worktree.sh" ] && ok "setup-worktree.sh is executable" || warn "config/setup-worktree.sh is missing or not executable"
if git -C "$REPO_ROOT" check-ignore -q "$MAISTRO_HOME/state/x" 2>/dev/null; then ok "state/ and worktrees/ are git-ignored"
else warn ".maistro/state is not git-ignored (is .maistro/.gitignore present?)"; fi
if [ -n "$(git -C "$REPO_ROOT" status --porcelain -- .maistro 2>/dev/null)" ]; then
  warn ".maistro has uncommitted changes; commit it so your config travels with the repo"
fi

n_skills="$(find "$MAISTRO_HOME/plugin/skills" -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
if [ -f "$MAISTRO_HOME/plugin/.claude-plugin/plugin.json" ] && [ "$n_skills" -gt 0 ]; then
  ok "bundled skills: $n_skills (use as /maistro:<skill>)"
else bad "bundled skills plugin missing at .maistro/plugin"; fi
ok "plans folder: $MAISTRO_PLANS_DIR/ (specs and tickets)"

[ "$fail" = 0 ] && echo "ready." || echo "fix the FAIL items above, then run maistro again."
exit "$fail"
