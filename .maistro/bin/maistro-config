#!/usr/bin/env bash
# maistro-config: prints the resolved settings that skills and agents need, one per line.
. "$(dirname "$0")/lib.sh"
cat <<OUT
repo_root=$REPO_ROOT
base_branch=$(base_branch)
base_ref=$(base_ref 2>/dev/null)          (merge this into a task branch to bring it up to date)
review_mode=$(review_mode)               (github: GitHub PRs; local: git review and merge, no remote needed)
harness=$MAISTRO_HARNESS
plans=$MAISTRO_PLANS_DIR/<plan>/            (one folder per plan)
spec=$MAISTRO_PLANS_DIR/<plan>/spec.md
tickets=$MAISTRO_PLANS_DIR/<plan>/tickets/<id>-<slug>.md   (manage with maistro-ticket)
decisions=$MAISTRO_PLANS_DIR/decisions/NNNN-<slug>.md
glossary=$MAISTRO_GLOSSARY
worklogs=$MAISTRO_WORKLOG_DIR/<task-id>.md
OUT
